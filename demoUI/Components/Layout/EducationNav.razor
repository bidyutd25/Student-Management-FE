        <RadzenMenuItem Text="Home" Icon="home" Path="/" />
        <RadzenMenuItem Text="Students" Icon="school" Path="/students" />
        <RadzenMenuItem Text="Courses" Icon="menu_book" Path="/courses" />
        <RadzenMenuItem Text="Scorecards" Icon="grading" Path="/scorecard" />
    </RadzenMenu>

    <RadzenAppearanceToggle />
</RadzenStack>