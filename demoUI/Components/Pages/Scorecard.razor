@page "/scorecard/{StudentId:int?}"
@inject EducationApi Api
@inject NavigationManager Nav

<PageTitle>Scorecard</PageTitle>

<h3>Scorecard</h3>

<Alert Message="@error" />

@if (loading)
{
    <p>Loading...</p>
}
else if (StudentId is null)
{
    <p class="text-muted">Choose a student to see their scorecard.</p>

    <div style="max-width:420px">
        <select class="form-select" @onchange="OnStudentSelected">
            <option value="0">Select a student...</option>
            @foreach (var s in students)
            {
                <option value="@s.Id">@s.Name (@s.Email)</option>
            }
        </select>
    </div>
}
else if (card is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0">@card.StudentName</h4>
            <a href="@($"students/{card.StudentId}")">View student</a> |
            <a href="scorecard">Choose another student</a>
        </div>
        <div class="text-end">
            <div class="text-muted small">Overall (completed courses)</div>
            <div class="fs-4">@(card.OverallPercentage is null ? "-" : $"{card.OverallPercentage:0.##}%")</div>
        </div>
    </div>

    @if (card.Courses.Count == 0)
    {
        <p class="text-muted">This student has no active or completed courses.</p>
    }

    @foreach (var c in card.Courses)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <strong>@c.CourseCode</strong> - @c.CourseTitle
                    <span class="badge @UiHelpers.StatusBadge(c.Status) ms-2">@c.Status</span>
                </div>
                <div>
                    <span class="me-2">@($"{c.FinalPercentage:0.##}%")</span>
                    <span class="badge fs-6 @UiHelpers.GradeBadge(c.Grade)">@c.Grade</span>
                </div>
            </div>
            <div class="card-body">
                @if (c.Assessments.Count == 0)
                {
                    <p class="text-muted mb-0">This course has no assessments yet.</p>
                }
                else
                {
                    <table class="table table-sm align-middle mb-2">
                        <thead>
                            <tr>
                                <th>Assessment</th>
                                <th>Marks</th>
                                <th>Weight</th>
                                <th>Weighted score</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in c.Assessments)
                            {
                                <tr>
                                    <td>@a.Name</td>
                                    <td>@(a.MarksObtained is null ? "-" : $"{a.MarksObtained:0.##} / {a.MaxMarks:0.##}")</td>
                                    <td>@a.Weightage.ToString("0.##")%</td>
                                    <td>@(a.WeightedScore is null ? "-" : a.WeightedScore.Value.ToString("0.##"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <a class="btn btn-sm btn-outline-primary" href="@($"scores/{c.EnrollmentId}")">Enter or edit scores</a>
            </div>
        </div>
    }
}

@code {
    // /scorecard shows the student picker, /scorecard/3 shows the scorecard of student 3
    [Parameter] public int? StudentId { get; set; }

    private StudentScorecardDto? card;
    private List<StudentDto> students = new();
    private bool loading;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        card = null;

        if (StudentId is null)
        {
            var result = await Api.GetStudentsAsync(null, 1, 100, "Name", "asc");
            students = result.Success ? result.Value!.Data : new List<StudentDto>();
            if (!result.Success)
                error = result.Error;
        }
        else
        {
            var result = await Api.GetStudentScorecardAsync(StudentId.Value);
            if (result.Success)
                card = result.Value;
            else
                error = result.Error;
        }

        loading = false;
    }

    private void OnStudentSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id) && id > 0)
            Nav.NavigateTo($"scorecard/{id}");
    }
}
