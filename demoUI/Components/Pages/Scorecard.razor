@page "/scorecard/{StudentId:int?}"
@rendermode InteractiveServer
@using Radzen
@using Radzen.Blazor
@using System.ComponentModel.DataAnnotations;
@using demoUI.Models;
@inject EducationApi Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>Scorecard</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">Scorecard</RadzenText>

@if (loading)
{
    <RadzenText>Loading...</RadzenText>
}
else if (StudentId is null)
{
    <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-2">Choose a student to see their scorecard.</RadzenText>

    <RadzenDropDown TValue="int?"
                    Data="@students"
                    TextProperty="Name"
                    ValueProperty="Id"
                    AllowFiltering="true"
                    Placeholder="Select a student..."
                    Change="@OnStudentSelected"
                    Style="width:100%;max-width:420px" />
}
else if (card is null)
{
    <RadzenText>This student does not exist.</RadzenText>
    <RadzenButton Text="Choose another student" ButtonStyle="ButtonStyle.Light"
                  Click="@(() => Nav.NavigateTo("scorecard"))" />
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.Center"
                 class="rz-mb-4">
        <RadzenStack Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@card.StudentName</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="View student" Icon="person" Size="ButtonSize.Small"
                              Click="@(() => Nav.NavigateTo($"students/{card.StudentId}"))" />
                <RadzenButton Text="Choose another student" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                              Click="@(() => Nav.NavigateTo("scorecard"))" />
            </RadzenStack>
        </RadzenStack>
        <RadzenStack AlignItems="AlignItems.End" Gap="0">
            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">Overall (completed courses)</RadzenText>
            <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">
                @(card.OverallPercentage is null ? "-" : $"{card.OverallPercentage:0.##}%")
            </RadzenText>
        </RadzenStack>
    </RadzenStack>

    @if (card.Courses.Count == 0)
    {
        <RadzenText>This student has no active or completed courses.</RadzenText>
    }

    @foreach (var c in card.Courses)
    {
        <RadzenCard class="rz-mb-4">
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center"
                         class="rz-mb-2">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@c.CourseCode - @c.CourseTitle</RadzenText>
                    <RadzenBadge BadgeStyle="@UiHelpers.StatusBadge(c.Status)" Text="@c.Status.ToString()" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@($"{c.FinalPercentage:0.##}%")</RadzenText>
                    <RadzenBadge BadgeStyle="@UiHelpers.GradeBadge(c.Grade)" Text="@c.Grade" />
                </RadzenStack>
            </RadzenStack>

            <RadzenDataGrid TItem="AssessmentResultDto" Data="@c.Assessments" AllowPaging="false" AllowSorting="false">
                <EmptyTemplate>
                    <RadzenText>This course has no assessments yet.</RadzenText>
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="AssessmentResultDto" Property="Name" Title="Assessment" />

                    <RadzenDataGridColumn TItem="AssessmentResultDto" Title="Marks" Width="160px">
                        <Template Context="a">
                            @(a.MarksObtained is null ? "-" : $"{a.MarksObtained:0.##} / {a.MaxMarks:0.##}")
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="AssessmentResultDto" Title="Weight" Width="110px">
                        <Template Context="a">@($"{a.Weightage:0.##}%")</Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="AssessmentResultDto" Title="Weighted score" Width="160px">
                        <Template Context="a">
                            @(a.WeightedScore is null ? "-" : a.WeightedScore.Value.ToString("0.##"))
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>

            <RadzenButton Text="Enter or edit scores" Icon="edit_note" Size="ButtonSize.Small" class="rz-mt-3"
                          Click="@(() => Nav.NavigateTo($"scores/{c.EnrollmentId}"))" />
        </RadzenCard>
    }
}

@code {
    // /scorecard shows the student picker, /scorecard/3 shows the scorecard of student 3
    [Parameter] public int? StudentId { get; set; }

    private StudentScorecardDto? card;
    private List<StudentDto> students = new();
    private bool loading;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        card = null;

        if (StudentId is null)
        {
            var result = await Api.GetStudentsAsync(null, 1, 100, "Name", "asc");
            if (result.Success)
                students = result.Value!.Data;
            else
                Notifications.Error(result.Error ?? "Could not load students.");
        }
        else
        {
            var result = await Api.GetStudentScorecardAsync(StudentId.Value);
            if (result.Success)
                card = result.Value;
            else
                Notifications.Error(result.Error ?? "Could not load the scorecard.");
        }

        loading = false;
    }

    private void OnStudentSelected(object value)
    {
        if (value is int id && id > 0)
            Nav.NavigateTo($"scorecard/{id}");
    }
}
