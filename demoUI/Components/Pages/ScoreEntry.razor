@page "/scores/{EnrollmentId:int}"
@rendermode InteractiveServer
@using Radzen
@using Radzen.Blazor
@using System.ComponentModel.DataAnnotations;
@using demoUI.Models;
@inject EducationApi Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>Enter scores</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-4">
    <RadzenButton Icon="arrow_back"
                  Text="@(header is null ? "Students" : header.StudentName)"
                  ButtonStyle="ButtonStyle.Light"
                  Click="@(() => Nav.NavigateTo(header is null ? "students" : $"students/{header.StudentId}"))" />
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Enter scores</RadzenText>
</RadzenStack>

@if (loading)
{
    <RadzenText>Loading...</RadzenText>
}
else if (header is null)
{
    <RadzenText>This enrollment does not exist.</RadzenText>
}
else
{
    var course = header.Course;
    var dropped = course.Status == EnrollmentStatus.Dropped;

    <RadzenCard class="rz-mb-4">
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center">
            <RadzenStack Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@header.StudentName</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0">@course.CourseCode - @course.CourseTitle</RadzenText>
                    <RadzenBadge BadgeStyle="@UiHelpers.StatusBadge(course.Status)" Text="@course.Status.ToString()" />
                </RadzenStack>
            </RadzenStack>
            <RadzenStack AlignItems="AlignItems.End" Gap="0.25rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@($"{course.FinalPercentage:0.##}%")</RadzenText>
                    <RadzenBadge BadgeStyle="@UiHelpers.GradeBadge(course.Grade)" Text="@course.Grade" />
                </RadzenStack>
                <RadzenButton Text="Open full scorecard" Icon="grading" Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Success"
                              Click="@(() => Nav.NavigateTo($"scorecard/{header.StudentId}"))" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    @if (dropped)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-2" Style="color:var(--rz-warning)">
            This enrollment was dropped, so scores can no longer be changed.
        </RadzenText>
    }

    @if (rows.Count == 0)
    {
        <RadzenText>
            This course has no assessments yet.
        </RadzenText>
        <RadzenButton Text="Add assessments" Icon="assignment" ButtonStyle="ButtonStyle.Info"
                      Click="@(() => Nav.NavigateTo($"courses/{course.CourseId}/assessments"))" />
    }
    else
    {
        <RadzenDataGrid TItem="ScoreRow" Data="@rows" AllowPaging="false" AllowSorting="false">
            <Columns>
                <RadzenDataGridColumn TItem="ScoreRow" Property="Name" Title="Assessment" />

                <RadzenDataGridColumn TItem="ScoreRow" Title="Max" Width="90px">
                    <Template Context="row">@row.MaxMarks.ToString("0.##")</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ScoreRow" Title="Weight" Width="100px">
                    <Template Context="row">@($"{row.Weightage:0.##}%")</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ScoreRow" Title="Marks" Width="170px">
                    <Template Context="row">
                        <RadzenNumeric TValue="decimal?" @bind-Value="row.Marks"
                                       Min="0" Max="@row.MaxMarks" Step="0.5"
                                       Disabled="@dropped" Style="width:100%" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ScoreRow" Title="Remarks" Width="260px">
                    <Template Context="row">
                        <RadzenTextBox @bind-Value="row.Remarks" Disabled="@dropped" Style="width:100%" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ScoreRow" Title="Actions" Width="170px" TextAlign="TextAlign.Center">
                    <Template Context="row">
                        <RadzenButton Text="Save" Icon="save" Size="ButtonSize.Small" Disabled="@dropped"
                                      Click="@(() => SaveRowAsync(row))" />
                        @if (row.ScoreId is not null)
                        {
                            <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                          title="Clear this score" Disabled="@dropped"
                                          Click="@(() => ClearRowAsync(row))" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
}

@code {
    // /scores/7 gives EnrollmentId = 7
    [Parameter] public int EnrollmentId { get; set; }

    private EnrollmentScorecardDto? header;
    private List<ScoreRow> rows = new();
    private bool loading;

    private class ScoreRow
    {
        public int AssessmentId { get; set; }
        public string Name { get; set; } = "";
        public decimal MaxMarks { get; set; }
        public decimal Weightage { get; set; }
        public decimal? Marks { get; set; }
        public string? Remarks { get; set; }
        public int? ScoreId { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        header = null;
        rows = new List<ScoreRow>();

        var card = await Api.GetEnrollmentScorecardAsync(EnrollmentId);
        if (!card.Success)
        {
            Notifications.Error(card.Error ?? "Enrollment not found.");
            loading = false;
            return;
        }

        header = card.Value!;

        var scores = await Api.GetScoresAsync(EnrollmentId);
        var byAssessment = scores.Success
            ? scores.Value!.ToDictionary(s => s.AssessmentId)
            : new Dictionary<int, ScoreDto>();

        foreach (var a in header.Course.Assessments)
        {
            byAssessment.TryGetValue(a.AssessmentId, out var existing);

            rows.Add(new ScoreRow
            {
                AssessmentId = a.AssessmentId,
                Name = a.Name,
                MaxMarks = a.MaxMarks,
                Weightage = a.Weightage,
                Marks = a.MarksObtained,
                ScoreId = existing?.Id,
                Remarks = existing?.Remarks
            });
        }

        loading = false;
    }

    private async Task SaveRowAsync(ScoreRow row)
    {
        if (row.Marks is null)
        {
            Notifications.Warning($"Enter the marks for {row.Name} first.");
            return;
        }

        if (row.Marks < 0 || row.Marks > row.MaxMarks)
        {
            Notifications.Warning($"Marks for {row.Name} must be between 0 and {row.MaxMarks:0.##}.");
            return;
        }

        var result = await Api.SaveScoreAsync(EnrollmentId, row.AssessmentId, row.Marks.Value, row.Remarks);
        if (!result.Success)
        {
            Notifications.Error(result.Error ?? "Could not save the score.");
            return;
        }

        row.ScoreId = result.Value!.Id;
        Notifications.Success($"{row.Name} saved.");
        await RefreshSummaryAsync();
    }

    private async Task ClearRowAsync(ScoreRow row)
    {
        if (row.ScoreId is null)
            return;

        var result = await Api.DeleteScoreAsync(row.ScoreId.Value);
        if (!result.Success)
        {
            Notifications.Error(result.Error ?? "Could not clear the score.");
            return;
        }

        row.ScoreId = null;
        row.Marks = null;
        row.Remarks = null;
        Notifications.Success($"{row.Name} cleared.");
        await RefreshSummaryAsync();
    }

    // Only the summary card is refreshed, so marks typed into other rows are not lost
    private async Task RefreshSummaryAsync()
    {
        var card = await Api.GetEnrollmentScorecardAsync(EnrollmentId);
        if (card.Success)
            header = card.Value!;
    }
}
