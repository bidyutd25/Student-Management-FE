@page "/scores/{EnrollmentId:int}"
@inject EducationApi Api

<PageTitle>Enter scores</PageTitle>

<h3>Enter scores</h3>

@if (header is not null)
{
    <a href="@($"students/{header.StudentId}")">&larr; Back to @header.StudentName</a>
}
else
{
    <a href="students">&larr; Back to students</a>
}

<Alert Message="@error" />

@if (loading)
{
    <p class="mt-3">Loading...</p>
}
else if (header is not null)
{
    var course = header.Course;
    var dropped = course.Status == EnrollmentStatus.Dropped;

    <div class="card my-3">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <div><strong>@header.StudentName</strong></div>
                <div>@course.CourseCode - @course.CourseTitle
                    <span class="badge @UiHelpers.StatusBadge(course.Status) ms-1">@course.Status</span>
                </div>
            </div>
            <div class="text-end">
                <span class="fs-5 me-2">@($"{course.FinalPercentage:0.##}%")</span>
                <span class="badge fs-6 @UiHelpers.GradeBadge(course.Grade)">@course.Grade</span>
                <div>
                    <a href="@($"scorecard/{header.StudentId}")">Open full scorecard</a>
                </div>
            </div>
        </div>
    </div>

    @if (dropped)
    {
        <Alert Kind="warning" Message="This enrollment was dropped, so scores can no longer be changed." />
    }

    @if (rows.Count == 0)
    {
        <p class="text-muted">
            This course has no assessments yet.
            <a href="@($"courses/{course.CourseId}/assessments")">Add assessments</a> first.
        </p>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Assessment</th>
                    <th>Max</th>
                    <th>Weight</th>
                    <th style="width:140px">Marks</th>
                    <th>Remarks</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td>@row.Name</td>
                        <td>@row.MaxMarks.ToString("0.##")</td>
                        <td>@row.Weightage.ToString("0.##")%</td>
                        <td>
                            <input type="number" step="0.01" min="0" max="@row.MaxMarks"
                                   class="form-control form-control-sm"
                                   @bind="row.Marks"
                                   disabled="@dropped" />
                        </td>
                        <td>
                            <input class="form-control form-control-sm" maxlength="255"
                                   @bind="row.Remarks"
                                   disabled="@dropped" />
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-primary" type="button"
                                    disabled="@dropped"
                                    @onclick="() => SaveRowAsync(row)">Save</button>
                            @if (row.ScoreId is not null)
                            {
                                <button class="btn btn-sm btn-outline-danger" type="button"
                                        disabled="@dropped"
                                        @onclick="() => ClearRowAsync(row)">Clear</button>
                            }
                            @if (row.Saved)
                            {
                                <span class="text-success ms-1">Saved</span>
                            }
                            @if (!string.IsNullOrEmpty(row.Error))
                            {
                                <div class="text-danger small">@row.Error</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    // /scores/7 gives EnrollmentId = 7
    [Parameter] public int EnrollmentId { get; set; }

    private EnrollmentScorecardDto? header;
    private List<ScoreRow> rows = new();
    private bool loading;
    private string? error;

    private class ScoreRow
    {
        public int AssessmentId { get; set; }
        public string Name { get; set; } = "";
        public decimal MaxMarks { get; set; }
        public decimal Weightage { get; set; }
        public decimal? Marks { get; set; }
        public string? Remarks { get; set; }
        public int? ScoreId { get; set; }
        public bool Saved { get; set; }
        public string? Error { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        header = null;
        rows = new List<ScoreRow>();

        var card = await Api.GetEnrollmentScorecardAsync(EnrollmentId);
        if (!card.Success)
        {
            error = card.Error;
            loading = false;
            return;
        }

        header = card.Value!;

        var scores = await Api.GetScoresAsync(EnrollmentId);
        var byAssessment = scores.Success
            ? scores.Value!.ToDictionary(s => s.AssessmentId)
            : new Dictionary<int, ScoreDto>();

        foreach (var a in header.Course.Assessments)
        {
            byAssessment.TryGetValue(a.AssessmentId, out var existing);

            rows.Add(new ScoreRow
            {
                AssessmentId = a.AssessmentId,
                Name = a.Name,
                MaxMarks = a.MaxMarks,
                Weightage = a.Weightage,
                Marks = a.MarksObtained,
                ScoreId = existing?.Id,
                Remarks = existing?.Remarks
            });
        }

        loading = false;
    }

    private async Task SaveRowAsync(ScoreRow row)
    {
        row.Error = null;
        row.Saved = false;

        if (row.Marks is null)
        {
            row.Error = "Enter the marks first.";
            return;
        }

        if (row.Marks < 0 || row.Marks > row.MaxMarks)
        {
            row.Error = $"Marks must be between 0 and {row.MaxMarks:0.##}.";
            return;
        }

        var result = await Api.SaveScoreAsync(EnrollmentId, row.AssessmentId, row.Marks.Value, row.Remarks);
        if (!result.Success)
        {
            row.Error = result.Error;
            return;
        }

        row.ScoreId = result.Value!.Id;
        row.Saved = true;
        await RefreshSummaryAsync();
    }

    private async Task ClearRowAsync(ScoreRow row)
    {
        row.Error = null;
        row.Saved = false;

        if (row.ScoreId is null)
            return;

        var result = await Api.DeleteScoreAsync(row.ScoreId.Value);
        if (!result.Success)
        {
            row.Error = result.Error;
            return;
        }

        row.ScoreId = null;
        row.Marks = null;
        row.Remarks = null;
        await RefreshSummaryAsync();
    }

    // Only the summary card is refreshed, so marks typed into other rows are not lost
    private async Task RefreshSummaryAsync()
    {
        var card = await Api.GetEnrollmentScorecardAsync(EnrollmentId);
        if (card.Success)
            header = card.Value!;
    }
}
