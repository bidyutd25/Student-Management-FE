@page "/courses"
@rendermode InteractiveServer
@using Radzen
@using Radzen.Blazor
@using System.ComponentModel.DataAnnotations;
@using demoUI.Models;

@inject EducationApi Api
@inject NavigationManager Nav
@inject DialogService Dialog
@inject NotificationService Notifications
@inject IJSRuntime JS


<PageTitle>Courses</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal"
             JustifyContent="JustifyContent.SpaceBetween"
             AlignItems="AlignItems.Center"
             class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Courses</RadzenText>
    <RadzenButton Text="Add course" Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                  Click="@(() => Nav.NavigateTo("courses/new"))" />
</RadzenStack>

<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" class="rz-mb-4">
    <RadzenTextBox @bind-Value="searchText" Placeholder="Search by code or title" Style="width:280px" />
    <RadzenDropDown TValue="string"
                    @bind-Value="statusValue"
                    Data="@statusOptions"
                    TextProperty="Text"
                    ValueProperty="Value"
                    Style="width:180px" />
    <RadzenButton Text="Search" Icon="search" Click="ApplyFilters" />
    <RadzenButton Text="Clear" ButtonStyle="ButtonStyle.Light" Click="ClearFilters" />
</RadzenStack>

<RadzenDataGrid @ref="grid"
                TItem="CourseDto"
                Data="@courses"
                Count="@totalCount"
                LoadData="@LoadData"
                IsLoading="@isLoading"
                AllowPaging="true"
                PageSize="10"
                PageSizeOptions="@pageSizeOptions"
                ShowPagingSummary="true"
                PagerHorizontalAlign="HorizontalAlign.Center"
                AllowSorting="false"
                AllowFiltering="false">
    <Columns>
        <RadzenDataGridColumn TItem="CourseDto" Property="Code" Title="Code" Width="140px" />
        <RadzenDataGridColumn TItem="CourseDto" Property="Title" Title="Title" />
        <RadzenDataGridColumn TItem="CourseDto" Property="Credits" Title="Credits" Width="100px" />

        <RadzenDataGridColumn TItem="CourseDto" Title="Status" Width="120px">
            <Template Context="c">
                <RadzenBadge BadgeStyle="@(c.IsActive ? BadgeStyle.Success : BadgeStyle.Secondary)"
                             Text="@(c.IsActive ? "Open" : "Closed")" />
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="CourseDto" Title="Actions" Width="190px" TextAlign="TextAlign.Center">
            <Template Context="c">
                <RadzenButton Icon="edit" Size="ButtonSize.Small" title="Edit"
                              Click="@(() => Nav.NavigateTo($"courses/{c.Id}"))" />
                <RadzenButton Icon="assignment" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" title="Assessments"
                              Click="@(() => Nav.NavigateTo($"courses/{c.Id}/assessments"))" />
                <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" title="Delete"
                              Click="@(() => DeleteAsync(c))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private record StatusOption(string Text, string Value);

    // Filters live in the URL: /courses?search=cs&active=true
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "active")] public bool? Active { get; set; }

    private RadzenDataGrid<CourseDto> grid = default!;
    private IEnumerable<int> pageSizeOptions = new[] { 5, 10, 20, 50 };

    private readonly List<StatusOption> statusOptions = new()
    {
        new("All courses", "all"),
        new("Open only", "true"),
        new("Closed only", "false")
    };

    private List<CourseDto> courses = new();
    private int totalCount;
    private bool isLoading;
    private string searchText = "";
    private string statusValue = "all";

    // Runs on the first visit and again whenever the query string changes
    protected override async Task OnParametersSetAsync()
    {
        searchText = Search ?? "";
        statusValue = Active switch
        {
            true => "true",
            false => "false",
            _ => "all"
        };

        // On the first visit the grid does not exist yet and loads itself on first render
        if (grid is not null)
        {
            await grid.GoToPage(0);
            await grid.Reload();
        }
    }
    
    protected override async Task OnInitializedAsync()
    {
        await LoadData(new LoadDataArgs());
    }
    
    private async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;
        await Task.Yield();

        var top = args.Top ?? 10;
        var skip = args.Skip ?? 0;

        var result = await Api.GetCoursesAsync(Search, Active, skip / top + 1, top);

        if (result.Success)
        {
            courses = result.Value!.Data;
            totalCount = result.Value.Pagination.TotalCount;
        }
        else
        {
            courses = new List<CourseDto>();
            totalCount = 0;
            Notifications.Error(result.Error ?? "Could not load courses.");
        }

        isLoading = false;
    }

    private void ApplyFilters()
    {
        bool? active = statusValue switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };

        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["search"] = string.IsNullOrWhiteSpace(searchText) ? null : searchText.Trim(),
            ["active"] = active
        }));
    }

    private void ClearFilters() => Nav.NavigateTo("courses");

    private async Task DeleteAsync(CourseDto course)
    {
        var confirmed = await Dialog.Confirm(
            $"Delete course {course.Code}?",
            "Delete course",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed != true)
            return;

        var result = await Api.DeleteCourseAsync(course.Id);
        if (!result.Success)
        {
            Notifications.Error(result.Error ?? "Could not delete the course.");
            return;
        }

        Notifications.Success("Course deleted.");
        await grid.Reload();
    }
}
