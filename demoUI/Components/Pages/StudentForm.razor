@page "/students/new"
@page "/students/{Id:int}"
@inject EducationApi Api
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Edit student" : "New student")</PageTitle>

<h3>@(IsEdit ? "Edit student" : "Add student")</h3>
<a href="students">&larr; Back to students</a>

<Alert Message="@error" />
<Alert Message="@message" Kind="success" />

@if (loading)
{
    <p class="mt-3">Loading...</p>
}
else if (!notFound)
{
    <EditForm Model="model" OnValidSubmit="SaveAsync" class="mt-3" style="max-width:560px">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label" for="name">Name</label>
            <InputText id="name" class="form-control" @bind-Value="model.Name" />
            <ValidationMessage For="() => model.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="model.Email" />
            <ValidationMessage For="() => model.Email" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="dob">Date of birth</label>
            <InputDate id="dob" class="form-control" @bind-Value="model.DateOfBirth" />
        </div>

        @if (!IsEdit)
        {
            <div class="mb-3">
                <label class="form-label">Courses (choose 1 to 3)</label>
                @if (activeCourses.Count == 0)
                {
                    <p class="text-muted">There are no open courses yet. <a href="courses/new">Create a course</a> first.</p>
                }
                @foreach (var course in activeCourses)
                {
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="@($"course-{course.Id}")"
                               checked="@selectedIds.Contains(course.Id)"
                               disabled="@(!selectedIds.Contains(course.Id) && selectedIds.Count >= MaxCourses)"
                               @onchange="e => ToggleCourse(course.Id, (bool)e.Value!)" />
                        <label class="form-check-label" for="@($"course-{course.Id}")">@course.Code - @course.Title</label>
                    </div>
                }
                <div class="form-text">Selected: @selectedIds.Count of @MaxCourses</div>
            </div>
        }

        <button class="btn btn-primary" type="submit" disabled="@saving">@(IsEdit ? "Save changes" : "Create student")</button>
        <a class="btn btn-outline-secondary" href="students">Cancel</a>
    </EditForm>

    @if (IsEdit)
    {
        <hr class="my-4" />
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Enrollments</h4>
            <a class="btn btn-outline-success btn-sm" href="@($"scorecard/{Id}")">View scorecard</a>
        </div>

        @if (enrollments.Count == 0)
        {
            <p class="text-muted mt-2">No enrollments.</p>
        }
        else
        {
            <table class="table align-middle mt-2">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Status</th>
                        <th>Enrolled on</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in enrollments)
                    {
                        <tr>
                            <td>@e.CourseCode - @e.CourseTitle</td>
                            <td><span class="badge @UiHelpers.StatusBadge(e.Status)">@e.Status</span></td>
                            <td>@e.EnrolledOn.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                @if (e.Status != EnrollmentStatus.Dropped)
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="@($"scores/{e.Id}")">Scores</a>
                                }
                                @if (e.Status == EnrollmentStatus.Active)
                                {
                                    <button class="btn btn-sm btn-outline-success" type="button"
                                            @onclick="() => ChangeStatusAsync(e, EnrollmentStatus.Completed)">Complete</button>
                                    <button class="btn btn-sm btn-outline-danger" type="button"
                                            @onclick="() => ChangeStatusAsync(e, EnrollmentStatus.Dropped)">Drop</button>
                                }
                                @if (e.Status == EnrollmentStatus.Dropped)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" type="button"
                                            @onclick="() => ChangeStatusAsync(e, EnrollmentStatus.Active)">Re-enroll</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="mt-3" style="max-width:560px">
            @if (ActiveCount >= MaxCourses)
            {
                <p class="text-muted">This student already has @MaxCourses active courses. Complete or drop one to enroll in another.</p>
            }
            else if (enrollableCourses.Count == 0)
            {
                <p class="text-muted">There are no other open courses to enroll in.</p>
            }
            else
            {
                <label class="form-label" for="enroll">Enroll in another course</label>
                <div class="input-group">
                    <select id="enroll" class="form-select" @bind="selectedCourseId">
                        <option value="0">Select a course...</option>
                        @foreach (var c in enrollableCourses)
                        {
                            <option value="@c.Id">@c.Code - @c.Title</option>
                        }
                    </select>
                    <button class="btn btn-primary" type="button" @onclick="EnrollAsync" disabled="@(selectedCourseId == 0)">Enroll</button>
                </div>
            }
        </div>
    }
}
else
{
    <p class="mt-3 text-muted">This student does not exist.</p>
}

@code {
    private const int MaxCourses = 3;

    // /students/new has no Id, /students/12 has Id = 12
    [Parameter] public int? Id { get; set; }

    private bool IsEdit => Id.HasValue;
    private int ActiveCount => enrollments.Count(e => e.Status == EnrollmentStatus.Active);

    private StudentFormModel model = new();
    private List<CourseDto> activeCourses = new();
    private List<EnrollmentDto> enrollments = new();
    private HashSet<int> selectedIds = new();
    private int selectedCourseId;

    private bool loading;
    private bool saving;
    private bool notFound;
    private string? error;
    private string? message;

    private int? loadedId;
    private bool initialised;

    private List<CourseDto> enrollableCourses =>
        activeCourses.Where(c => enrollments.All(e => e.CourseId != c.Id)).ToList();

    // The router reuses this component when you go from /students/5 to /students/new,
    // so react to parameter changes here instead of only in OnInitialized.
    protected override async Task OnParametersSetAsync()
    {
        if (initialised && loadedId == Id)
            return;

        initialised = true;
        loadedId = Id;

        loading = true;
        notFound = false;
        error = null;
        message = null;
        model = new StudentFormModel();
        selectedIds = new HashSet<int>();
        enrollments = new List<EnrollmentDto>();
        selectedCourseId = 0;

        var courses = await Api.GetCoursesAsync(null, true, 1, 100);
        activeCourses = courses.Success ? courses.Value!.Data : new List<CourseDto>();
        if (!courses.Success)
            error = courses.Error;

        if (IsEdit)
            await LoadStudentAsync();

        loading = false;
    }

    private async Task LoadStudentAsync()
    {
        var result = await Api.GetStudentAsync(Id!.Value);
        if (!result.Success)
        {
            notFound = true;
            error = result.Error;
            return;
        }

        var student = result.Value!;
        model = new StudentFormModel
        {
            Name = student.Name,
            Email = student.Email,
            DateOfBirth = student.DateOfBirth
        };

        await ReloadEnrollmentsAsync();
    }

    private async Task ReloadEnrollmentsAsync()
    {
        var result = await Api.GetEnrollmentsAsync(Id, null, null, 1, 100);
        enrollments = result.Success ? result.Value!.Data : new List<EnrollmentDto>();
        if (!result.Success)
            error = result.Error;
    }

    private void ToggleCourse(int courseId, bool isChecked)
    {
        if (isChecked && selectedIds.Count < MaxCourses)
            selectedIds.Add(courseId);
        else if (!isChecked)
            selectedIds.Remove(courseId);
    }

    private async Task SaveAsync()
    {
        error = null;
        message = null;

        if (model.DateOfBirth is { } dob && dob > DateOnly.FromDateTime(DateTime.Today))
        {
            error = "Date of birth cannot be in the future.";
            return;
        }

        if (!IsEdit && (selectedIds.Count < 1 || selectedIds.Count > MaxCourses))
        {
            error = $"Select between 1 and {MaxCourses} courses.";
            return;
        }

        saving = true;
        try
        {
            if (IsEdit)
            {
                var result = await Api.UpdateStudentAsync(Id!.Value, model);
                if (result.Success)
                    message = "Student saved.";
                else
                    error = result.Error;
            }
            else
            {
                var result = await Api.CreateStudentAsync(model, selectedIds);
                if (result.Success)
                    Nav.NavigateTo($"students/{result.Value!.Id}");   // go to the edit route of the new student
                else
                    error = result.Error;
            }
        }
        finally
        {
            saving = false;
        }
    }

    private async Task EnrollAsync()
    {
        error = null;
        message = null;

        var result = await Api.EnrollAsync(Id!.Value, selectedCourseId);
        if (!result.Success)
        {
            error = result.Error;
            return;
        }

        selectedCourseId = 0;
        message = "Enrolled.";
        await ReloadEnrollmentsAsync();
    }

    private async Task ChangeStatusAsync(EnrollmentDto enrollment, EnrollmentStatus status)
    {
        error = null;
        message = null;

        var result = await Api.ChangeEnrollmentStatusAsync(enrollment.Id, status);
        if (!result.Success)
        {
            error = result.Error;
            return;
        }

        message = $"{enrollment.CourseCode} is now {status}.";
        await ReloadEnrollmentsAsync();
    }
}
