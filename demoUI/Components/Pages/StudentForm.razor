@page "/students/new"
@page "/students/{Id:int}"
@rendermode InteractiveServer
@using Radzen
@using Radzen.Blazor
@using System.ComponentModel.DataAnnotations;
@using demoUI.Models;
@inject EducationApi Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>@(IsEdit ? "Edit student" : "New student")</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-4">
    <RadzenButton Icon="arrow_back" Text="Students" ButtonStyle="ButtonStyle.Light"
                  Click="@(() => Nav.NavigateTo("students"))" />
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@(IsEdit ? "Edit student" : "Add student")</RadzenText>
</RadzenStack>

@if (loading)
{
    <RadzenText>Loading...</RadzenText>
}
else if (notFound)
{
    <RadzenText>This student does not exist.</RadzenText>
}
else
{
    <RadzenTemplateForm TItem="StudentFormModel" Data="@model" Submit="@SaveAsync" Style="max-width:560px">
        <RadzenStack Gap="1rem">

            <RadzenStack Gap="0.25rem">
                <RadzenLabel Text="Name" Component="StudentName" />
                <RadzenTextBox Name="StudentName" @bind-Value="model.Name" Style="width:100%" />
                <RadzenRequiredValidator Component="StudentName" Text="Name is required" />
                <RadzenLengthValidator Component="StudentName" Min="3" Max="100"
                                       Text="Name must be at least 3 characters long" />
                <RadzenRegexValidator Component="StudentName"
                                      Pattern="@StudentFormModel.NamePattern"
                                      Text="Name can contain only letters and single spaces" />
            </RadzenStack>

            <RadzenStack Gap="0.25rem">
                <RadzenLabel Text="Email" Component="StudentEmail" />
                <RadzenTextBox Name="StudentEmail" @bind-Value="model.Email" Style="width:100%" />
                <RadzenRequiredValidator Component="StudentEmail" Text="Email is required" />
                <RadzenRegexValidator Component="StudentEmail"
                                      Pattern="@StudentFormModel.EmailPattern"
                                      Text="Enter a valid email address" />
            </RadzenStack>

            <RadzenStack Gap="0.25rem">
                <RadzenLabel Text="Date of birth" Component="StudentDob" />
                <RadzenDatePicker Name="StudentDob" TValue="DateTime?" @bind-Value="dateOfBirth"
                                  DateFormat="dd MMM yyyy" Style="width:100%" />
                <RadzenRequiredValidator Component="StudentDob" Text="Date of birth is required" />
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">The student must be older than 15.</RadzenText>
            </RadzenStack>

            @if (!IsEdit)
            {
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Courses (choose 1 to 3)" Component="StudentCourses" />
                    <RadzenDropDown Name="StudentCourses"
                                    TValue="IEnumerable<int>"
                                    Multiple="true"
                                    Chips="true"
                                    AllowClear="true"
                                    AllowFiltering="true"
                                    Data="@activeCourses"
                                    TextProperty="Label"
                                    ValueProperty="Id"
                                    @bind-Value="selectedIds"
                                    Placeholder="Select courses"
                                    Style="width:100%" />
                    <RadzenText TextStyle="TextStyle.Caption"
                                Style="@(SelectedCount > MaxCourses ? "color:var(--rz-danger)" : "")">
                        Selected: @SelectedCount of @MaxCourses
                    </RadzenText>
                    @if (activeCourses.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Caption">
                            There are no open courses yet. Create a course first.
                        </RadzenText>
                    }
                </RadzenStack>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Disabled="@saving"
                              Text="@(IsEdit ? "Save changes" : "Create student")" />
                <RadzenButton ButtonType="ButtonType.Button" Text="Cancel" ButtonStyle="ButtonStyle.Light"
                              Click="@(() => Nav.NavigateTo("students"))" />
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>

    @if (IsEdit)
    {
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center"
                     class="rz-mt-6 rz-mb-2">
            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">Enrollments</RadzenText>
            <RadzenButton Text="View scorecard" Icon="grading" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                          Click="@(() => Nav.NavigateTo($"scorecard/{Id}"))" />
        </RadzenStack>

        <RadzenDataGrid TItem="EnrollmentDto" Data="@enrollments" AllowPaging="false" AllowSorting="false">
            <EmptyTemplate>
                <RadzenText>No enrollments.</RadzenText>
            </EmptyTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="EnrollmentDto" Title="Course">
                    <Template Context="e">@e.CourseCode - @e.CourseTitle</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="EnrollmentDto" Title="Status" Width="130px">
                    <Template Context="e">
                        <RadzenBadge BadgeStyle="@UiHelpers.StatusBadge(e.Status)" Text="@e.Status.ToString()" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="EnrollmentDto" Title="Enrolled on" Width="140px">
                    <Template Context="e">@e.EnrolledOn.ToString("dd MMM yyyy")</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="EnrollmentDto" Title="Actions" Width="300px" TextAlign="TextAlign.Center">
                    <Template Context="e">
                        @if (e.Status != EnrollmentStatus.Dropped)
                        {
                            <RadzenButton Text="Scores" Icon="edit_note" Size="ButtonSize.Small"
                                          Click="@(() => Nav.NavigateTo($"scores/{e.Id}"))" />
                        }
                        @if (e.Status == EnrollmentStatus.Active)
                        {
                            <RadzenButton Text="Complete" Icon="check_circle" Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Success"
                                          Click="@(() => ChangeStatusAsync(e, EnrollmentStatus.Completed))" />
                            <RadzenButton Text="Drop" Icon="remove_circle" Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Click="@(() => ChangeStatusAsync(e, EnrollmentStatus.Dropped))" />
                        }
                        @if (e.Status == EnrollmentStatus.Dropped)
                        {
                            <RadzenButton Text="Re-enroll" Icon="replay" Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Click="@(() => ChangeStatusAsync(e, EnrollmentStatus.Active))" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        <div class="rz-mt-4" style="max-width:560px">
            @if (ActiveCount >= MaxCourses)
            {
                <RadzenText TextStyle="TextStyle.Body2">
                    This student already has @MaxCourses active courses. Complete or drop one to enroll in another.
                </RadzenText>
            }
            else if (enrollableCourses.Count == 0)
            {
                <RadzenText TextStyle="TextStyle.Body2">There are no other open courses to enroll in.</RadzenText>
            }
            else
            {
                <RadzenLabel Text="Enroll in another course" Component="EnrollCourse" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-1">
                    <RadzenDropDown Name="EnrollCourse"
                                    TValue="int?"
                                    AllowClear="true"
                                    AllowFiltering="true"
                                    Data="@enrollableCourses"
                                    TextProperty="Label"
                                    ValueProperty="Id"
                                    @bind-Value="selectedCourseId"
                                    Placeholder="Select a course..."
                                    Style="width:100%" />
                    <RadzenButton Text="Enroll" Icon="add" Disabled="@(selectedCourseId is null)" Click="EnrollAsync" />
                </RadzenStack>
            }
        </div>
    }
}

@code {
    private const int MaxCourses = 3;

    // /students/new has no Id, /students/12 has Id = 12
    [Parameter] public int? Id { get; set; }

    private bool IsEdit => Id.HasValue;
    private int SelectedCount => selectedIds?.Count() ?? 0;
    private int ActiveCount => enrollments.Count(e => e.Status == EnrollmentStatus.Active);

    private StudentFormModel model = new();
    private DateTime? dateOfBirth;
    private List<CourseDto> activeCourses = new();
    private List<EnrollmentDto> enrollments = new();
    private IEnumerable<int> selectedIds = new List<int>();
    private int? selectedCourseId;

    private bool loading;
    private bool saving;
    private bool notFound;

    private int? loadedId;
    private bool initialised;

    private List<CourseDto> enrollableCourses =>
        activeCourses.Where(c => enrollments.All(e => e.CourseId != c.Id)).ToList();

    // The router reuses this component when you go from /students/5 to /students/new,
    // so react to parameter changes here instead of only in OnInitialized.
    protected override async Task OnParametersSetAsync()
    {
        if (initialised && loadedId == Id)
            return;

        initialised = true;
        loadedId = Id;

        loading = true;
        notFound = false;
        model = new StudentFormModel();
        dateOfBirth = null;
        selectedIds = new List<int>();
        enrollments = new List<EnrollmentDto>();
        selectedCourseId = null;

        var courses = await Api.GetCoursesAsync(null, true, 1, 100);
        if (courses.Success)
            activeCourses = courses.Value!.Data;
        else
            Notifications.Error(courses.Error ?? "Could not load courses.");

        if (IsEdit)
            await LoadStudentAsync();

        loading = false;
    }

    private async Task LoadStudentAsync()
    {
        var result = await Api.GetStudentAsync(Id!.Value);
        if (!result.Success)
        {
            notFound = true;
            Notifications.Error(result.Error ?? "Student not found.");
            return;
        }

        var student = result.Value!;
        model = new StudentFormModel
        {
            Name = student.Name,
            Email = student.Email,
            DateOfBirth = student.DateOfBirth
        };
        dateOfBirth = student.DateOfBirth?.ToDateTime(TimeOnly.MinValue);

        await ReloadEnrollmentsAsync();
    }

    private async Task ReloadEnrollmentsAsync()
    {
        var result = await Api.GetEnrollmentsAsync(Id, null, null, 1, 100);
        if (result.Success)
            enrollments = result.Value!.Data;
        else
            Notifications.Error(result.Error ?? "Could not load enrollments.");
    }

    private async Task SaveAsync(StudentFormModel submitted)
    {
        model.DateOfBirth = dateOfBirth is null ? null : DateOnly.FromDateTime(dateOfBirth.Value);

                if (model.DateOfBirth is not { } dob)
        {
            Notifications.Warning("Date of birth is required.");
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        if (dob > today)
        {
            Notifications.Warning("Date of birth cannot be in the future.");
            return;
        }

        var age = today.Year - dob.Year;
        if (dob > today.AddYears(-age))
            age--;

        if (age < StudentFormModel.MinimumAge)
        {
            Notifications.Warning("Student age must be greater than 15.");
            return;
        }

        var courseIds = selectedIds?.ToList() ?? new List<int>();
        if (!IsEdit && (courseIds.Count < 1 || courseIds.Count > MaxCourses))
        {
            Notifications.Warning($"Select between 1 and {MaxCourses} courses.");
            return;
        }

        saving = true;
        try
        {
            if (IsEdit)
            {
                var result = await Api.UpdateStudentAsync(Id!.Value, model);
                if (result.Success)
                    Notifications.Success("Student saved.");
                else
                    Notifications.Error(result.Error ?? "Could not save the student.");
            }
            else
            {
                var result = await Api.CreateStudentAsync(model, courseIds);
                if (result.Success)
                {
                    Notifications.Success("Student created.");
                    Nav.NavigateTo($"students/{result.Value!.Id}");   // continue on the edit route of the new student
                }
                else
                {
                    Notifications.Error(result.Error ?? "Could not create the student.");
                }
            }
        }
        finally
        {
            saving = false;
        }
    }

    private async Task EnrollAsync()
    {
        if (selectedCourseId is null)
            return;

        var result = await Api.EnrollAsync(Id!.Value, selectedCourseId.Value);
        if (!result.Success)
        {
            Notifications.Error(result.Error ?? "Could not enroll the student.");
            return;
        }

        selectedCourseId = null;
        Notifications.Success("Enrolled.");
        await ReloadEnrollmentsAsync();
    }

    private async Task ChangeStatusAsync(EnrollmentDto enrollment, EnrollmentStatus status)
    {
        var result = await Api.ChangeEnrollmentStatusAsync(enrollment.Id, status);
        if (!result.Success)
        {
            Notifications.Error(result.Error ?? "Could not change the status.");
            return;
        }

        Notifications.Success($"{enrollment.CourseCode} is now {status}.");
        await ReloadEnrollmentsAsync();
    }
}
