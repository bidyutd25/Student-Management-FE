@page "/courses/{CourseId:int}/assessments"
@inject EducationApi Api
@inject IJSRuntime JS

<PageTitle>Assessments</PageTitle>

<h3>Assessments @(course is null ? "" : $"- {course.Code} {course.Title}")</h3>
<a href="courses">&larr; Back to courses</a>

<Alert Message="@error" />
<Alert Message="@message" Kind="success" />

@if (loading)
{
    <p class="mt-3">Loading...</p>
}
else if (course is null)
{
    <p class="mt-3 text-muted">This course does not exist.</p>
}
else
{
    <p class="mt-3">
        Weightage used: <strong>@used.ToString("0.##")</strong> of 100
        (remaining: <strong>@remaining.ToString("0.##")</strong>).
        <span class="text-muted">The weightages should add up to 100 for a student to be able to reach 100%.</span>
    </p>

    @if (assessments.Count == 0)
    {
        <p class="text-muted">No assessments defined yet.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Max marks</th>
                    <th>Weightage (%)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in assessments)
                {
                    <tr class="@(editingId == a.Id ? "table-warning" : "")">
                        <td>@a.Name</td>
                        <td>@a.MaxMarks.ToString("0.##")</td>
                        <td>@a.Weightage.ToString("0.##")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => StartEdit(a)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeleteAsync(a)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h5 class="mt-4">@(editingId is null ? "Add assessment" : "Edit assessment")</h5>

    <EditForm Model="form" OnValidSubmit="SaveAsync" style="max-width:560px">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label" for="aname">Name</label>
            <InputText id="aname" class="form-control" @bind-Value="form.Name" placeholder="Midterm, Final, Quiz 1..." />
            <ValidationMessage For="() => form.Name" />
        </div>

        <div class="row">
            <div class="col-6 mb-3">
                <label class="form-label" for="amax">Max marks</label>
                <InputNumber id="amax" class="form-control" @bind-Value="form.MaxMarks" />
                <ValidationMessage For="() => form.MaxMarks" />
            </div>
            <div class="col-6 mb-3">
                <label class="form-label" for="aweight">Weightage (%)</label>
                <InputNumber id="aweight" class="form-control" @bind-Value="form.Weightage" />
                <ValidationMessage For="() => form.Weightage" />
            </div>
        </div>

        <button class="btn btn-primary" type="submit" disabled="@saving">@(editingId is null ? "Add" : "Save changes")</button>
        @if (editingId is not null)
        {
            <button class="btn btn-outline-secondary" type="button" @onclick="ResetForm">Cancel edit</button>
        }
    </EditForm>
}

@code {
    // /courses/3/assessments gives CourseId = 3
    [Parameter] public int CourseId { get; set; }

    private CourseDto? course;
    private List<AssessmentDto> assessments = new();
    private AssessmentFormModel form = new();
    private int? editingId;

    private bool loading;
    private bool saving;
    private string? error;
    private string? message;

    private decimal used => assessments.Sum(a => a.Weightage);
    private decimal remaining => 100 - used;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        message = null;
        ResetForm();

        var courseResult = await Api.GetCourseAsync(CourseId);
        course = courseResult.Success ? courseResult.Value : null;
        if (!courseResult.Success)
            error = courseResult.Error;

        if (course is not null)
            await LoadAssessmentsAsync();

        loading = false;
    }

    private async Task LoadAssessmentsAsync()
    {
        var result = await Api.GetAssessmentsAsync(CourseId);
        assessments = result.Success ? result.Value! : new List<AssessmentDto>();
        if (!result.Success)
            error = result.Error;
    }

    private void StartEdit(AssessmentDto assessment)
    {
        editingId = assessment.Id;
        form = new AssessmentFormModel
        {
            Name = assessment.Name,
            MaxMarks = assessment.MaxMarks,
            Weightage = assessment.Weightage
        };
        error = null;
        message = null;
    }

    private void ResetForm()
    {
        editingId = null;
        form = new AssessmentFormModel { MaxMarks = 100 };
    }

    private async Task SaveAsync()
    {
        error = null;
        message = null;
        saving = true;

        try
        {
            var result = editingId is null
                ? await Api.CreateAssessmentAsync(CourseId, form)
                : await Api.UpdateAssessmentAsync(editingId.Value, form);

            if (!result.Success)
            {
                error = result.Error;
                return;
            }

            message = editingId is null ? "Assessment added." : "Assessment updated.";
            ResetForm();
            await LoadAssessmentsAsync();
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync(AssessmentDto assessment)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete assessment {assessment.Name}?");
        if (!confirmed)
            return;

        error = null;
        message = null;

        var result = await Api.DeleteAssessmentAsync(assessment.Id);
        if (!result.Success)
        {
            error = result.Error;
            return;
        }

        if (editingId == assessment.Id)
            ResetForm();

        message = "Assessment deleted.";
        await LoadAssessmentsAsync();
    }
}
