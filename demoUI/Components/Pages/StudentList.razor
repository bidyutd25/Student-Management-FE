@page "/students"
@rendermode InteractiveServer
@using Radzen
@using Radzen.Blazor
@using System.ComponentModel.DataAnnotations;
@using demoUI.Models;
@inject EducationApi Api
@inject NavigationManager Nav
@inject DialogService Dialog
@inject NotificationService Notifications
@inject IJSRuntime JS


<PageTitle>Students</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal"
             JustifyContent="JustifyContent.SpaceBetween"
             AlignItems="AlignItems.Center"
             class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Students</RadzenText>
    <RadzenButton Text="Add student"
                  Icon="add_circle"
                  ButtonStyle="ButtonStyle.Primary"
                  Click="@(() => Nav.NavigateTo("students/new"))" />
</RadzenStack>

<RadzenDataGrid @ref="grid"
                TItem="StudentDto"
                Data="@students"
                Count="@totalCount"
                LoadData="@LoadData"
                IsLoading="@isLoading"
                AllowPaging="true"
                PageSize="10"
                PageSizeOptions="@pageSizeOptions"
                ShowPagingSummary="true"
                PagerHorizontalAlign="HorizontalAlign.Center"
                AllowSorting="true"
                AllowFiltering="true"
                FilterMode="FilterMode.Simple">
    <Columns>
        <RadzenDataGridColumn TItem="StudentDto" Property="Id" Title="ID" Width="80px" Filterable="false" />

        <RadzenDataGridColumn TItem="StudentDto" Property="Name" Title="Name" />

        <RadzenDataGridColumn TItem="StudentDto" Property="Email" Title="Email" />

        <RadzenDataGridColumn TItem="StudentDto" Property="Age" Title="Age" Width="90px"
                              Sortable="false" Filterable="false">
            <Template Context="s">@(s.Age?.ToString() ?? "-")</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="StudentDto" Property="ActiveCourses" Title="Active courses" Width="140px"
                              Sortable="false" Filterable="false" />

        <RadzenDataGridColumn TItem="StudentDto" Title="Actions" Width="190px"
                              Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
            <Template Context="s">
                <RadzenButton Icon="edit" Size="ButtonSize.Small" title="Edit"
                              Click="@(() => Nav.NavigateTo($"students/{s.Id}"))" />
                <RadzenButton Icon="grading" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" title="Scorecard"
                              Click="@(() => Nav.NavigateTo($"scorecard/{s.Id}"))" />
                <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" title="Delete"
                              Click="@(() => DeleteAsync(s))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private static readonly string[] SortableColumns = { "Id", "Name", "Email" };

    private RadzenDataGrid<StudentDto> grid = default!;
    private IEnumerable<int> pageSizeOptions = new[] { 5, 10, 20, 50 };
    private List<StudentDto> students = new();
    private int totalCount; 
    private bool isLoading;

    // Radzen calls this on the first render and on every page, page-size, sort or filter change
    protected override async Task OnInitializedAsync()
    {
        await LoadData(new LoadDataArgs());
    }

    private async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;
        await Task.Yield();

        var top = args.Top ?? 10;
        var skip = args.Skip ?? 0;
        var pageNumber = skip / top + 1;

        var (sortBy, sortOrder) = GridHelpers.ParseSort(args.OrderBy, SortableColumns);

        string? name = null;
        string? email = null;
        foreach (var filter in args.Filters ?? Enumerable.Empty<FilterDescriptor>())
        {
            var value = filter.FilterValue?.ToString()?.Trim();
            if (string.IsNullOrWhiteSpace(value))
                continue;

            switch (filter.Property)
            {
                case "Name": name = value; break;
                case "Email": email = value; break;
            }
        }

        var result = await Api.GetStudentsAsync(name, pageNumber, top, sortBy, sortOrder, CancellationToken.None);

        if (result.Success)
        {
            students = result.Value!.Data;
            totalCount = result.Value.Pagination.TotalCount;
        }
        else
        {
            students = new List<StudentDto>();
            totalCount = 0;
            Notifications.Error(result.Error ?? "Could not load students.");
        }

        isLoading = false;
    }

    private async Task DeleteAsync(StudentDto student)
    {
        var confirmed = await Dialog.Confirm(
            $"Delete {student.Name} together with their enrollments and scores?",
            "Delete student",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed != true)
            return;

        var result = await Api.DeleteStudentAsync(student.Id);
        if (!result.Success)
        {
            Notifications.Error(result.Error ?? "Could not delete the student.");
            return;
        }

        Notifications.Success("Student deleted.");
        await grid.Reload();
    }
}
