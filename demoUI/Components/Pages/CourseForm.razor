@page "/courses/new"
@page "/courses/{Id:int}"
@rendermode InteractiveServer
@using Radzen
@using Radzen.Blazor
@using System.ComponentModel.DataAnnotations;
@using demoUI.Models;

@inject EducationApi Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>@(IsEdit ? "Edit course" : "New course")</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-4">
    <RadzenButton Icon="arrow_back" Text="Courses" ButtonStyle="ButtonStyle.Light"
                  Click="@(() => Nav.NavigateTo("courses"))" />
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@(IsEdit ? "Edit course" : "Add course")</RadzenText>
</RadzenStack>

@if (loading)
{
    <RadzenText>Loading...</RadzenText>
}
else if (notFound)
{
    <RadzenText>This course does not exist.</RadzenText>
}
else
{
    <RadzenTemplateForm TItem="CourseFormModel" Data="@model" Submit="@SaveAsync" Style="max-width:560px">
        <RadzenStack Gap="1rem">

            <RadzenStack Gap="0.25rem">
                <RadzenLabel Text="Code" Component="CourseCode" />
                <RadzenTextBox Name="CourseCode" @bind-Value="model.Code" Style="width:100%" />
                <RadzenRequiredValidator Component="CourseCode" Text="Code is required" />
                <RadzenLengthValidator Component="CourseCode" Min="2" Max="20"
                                       Text="Code must be 2 to 20 characters" />
            </RadzenStack>

            <RadzenStack Gap="0.25rem">
                <RadzenLabel Text="Title" Component="CourseTitle" />
                <RadzenTextBox Name="CourseTitle" @bind-Value="model.Title" Style="width:100%" />
                <RadzenRequiredValidator Component="CourseTitle" Text="Title is required" />
                <RadzenLengthValidator Component="CourseTitle" Min="2" Max="150"
                                       Text="Title must be 2 to 150 characters" />
            </RadzenStack>

            <RadzenStack Gap="0.25rem">
                <RadzenLabel Text="Credits" Component="CourseCredits" />
                <RadzenNumeric Name="CourseCredits" TValue="int" @bind-Value="model.Credits"
                               Min="1" Max="10" Style="width:100%" />
                <RadzenNumericRangeValidator Component="CourseCredits" Min="1" Max="10"
                                             Text="Credits must be between 1 and 10" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenCheckBox Name="CourseOpen" TValue="bool" @bind-Value="model.IsActive" />
                <RadzenLabel Text="Open for enrollment" Component="CourseOpen" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Disabled="@saving"
                              Text="@(IsEdit ? "Save changes" : "Create course")" />
                <RadzenButton ButtonType="ButtonType.Button" Text="Cancel" ButtonStyle="ButtonStyle.Light"
                              Click="@(() => Nav.NavigateTo("courses"))" />
                @if (IsEdit)
                {
                    <RadzenButton ButtonType="ButtonType.Button" Text="Manage assessments" Icon="assignment"
                                  ButtonStyle="ButtonStyle.Info"
                                  Click="@(() => Nav.NavigateTo($"courses/{Id}/assessments"))" />
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
}

@code {
    // /courses/new has no Id, /courses/3 has Id = 3
    [Parameter] public int? Id { get; set; }

    private bool IsEdit => Id.HasValue;

    private CourseFormModel model = new();
    private bool loading;
    private bool saving;
    private bool notFound;

    private int? loadedId;
    private bool initialised;

    protected override async Task OnParametersSetAsync()
    {
        if (initialised && loadedId == Id)
            return;

        initialised = true;
        loadedId = Id;

        notFound = false;
        model = new CourseFormModel();

        if (!IsEdit)
            return;

        loading = true;

        var result = await Api.GetCourseAsync(Id!.Value);
        if (result.Success)
        {
            var course = result.Value!;
            model = new CourseFormModel
            {
                Code = course.Code,
                Title = course.Title,
                Credits = course.Credits,
                IsActive = course.IsActive
            };
        }
        else
        {
            notFound = true;
            Notifications.Error(result.Error ?? "Course not found.");
        }

        loading = false;
    }

    private async Task SaveAsync(CourseFormModel submitted)
    {
        if (string.Equals(model.Code.Trim(), model.Title.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            Notifications.Warning("Course code and title cannot be the same.");
            return;
        }
        saving = true;

        try
        {
            var result = IsEdit
                ? await Api.UpdateCourseAsync(Id!.Value, model)
                : await Api.CreateCourseAsync(model);

            if (result.Success)
            {
                Notifications.Success(IsEdit ? "Course saved." : "Course created.");
                Nav.NavigateTo("courses");
            }
            else
            {
                Notifications.Error(result.Error ?? "Could not save the course.");
            }
        }
        finally
        {
            saving = false;
        }
    }
}
