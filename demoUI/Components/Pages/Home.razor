@page "/"

<PageTitle>Education Management</PageTitle>

<h2>Education Management</h2>
<p class="text-muted">Manage students, courses, enrollments and scorecards.</p>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Students</h5>
                <p class="card-text">Add students with 1 to 3 courses, edit details, and manage their enrollments.</p>
                <a class="btn btn-primary" href="students">Open students</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Courses</h5>
                <p class="card-text">Maintain courses and define the assessments and weightage of each one.</p>
                <a class="btn btn-primary" href="courses">Open courses</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Scorecards</h5>
                <p class="card-text">See the final percentage and grade of every course a student is taking.</p>
                <a class="btn btn-primary" href="scorecard">Open scorecards</a>
            </div>
        </div>
    </div>
</div>
