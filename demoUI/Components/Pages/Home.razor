@page "/"
@rendermode InteractiveServer
@using Radzen
@using Radzen.Blazor
@using System.ComponentModel.DataAnnotations;
@using demoUI.Models;
@inject EducationApi Api
@inject NavigationManager Nav

<PageTitle>Education Management</PageTitle>

<RadzenText TextStyle="TextStyle.H3">Education Management</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4">
    Manage students, courses, enrollments and scorecards.
</RadzenText>

<RadzenRow Gap="1rem">
    <RadzenColumn Size="12" SizeMD="4">
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">Students</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">
                    Add students with 1 to 3 courses, edit details, and manage their enrollments.
                </RadzenText>
                <RadzenButton Text="Open students" Icon="school" Click="@(() => Nav.NavigateTo("students"))" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="4">
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">Courses</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">
                    Maintain courses and define the assessments and weightage of each one.
                </RadzenText>
                <RadzenButton Text="Open courses" Icon="menu_book" Click="@(() => Nav.NavigateTo("courses"))" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="4">
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">Scorecards</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">
                    See the final percentage and grade of every course a student is taking.
                </RadzenText>
                <RadzenButton Text="Open scorecards" Icon="grading" Click="@(() => Nav.NavigateTo("scorecard"))" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>
